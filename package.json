{
  "name": "@obrier/plugboard",
  "version": "0.1.3",
  "description": "claude.ai connector tools from code and as shell commands, at zero model tokens",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obrier/plugboard.git"
  },
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    }
  },
  "types": "./dist/lib/index.d.ts",
  "files": [
    "dist/lib",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22",
    "bun": ">=1.4"
  },
  "scripts": {
    "build": "bun build --compile --minify --outfile=dist/plugboard ./src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "link": "sh scripts/link.sh",
    "build:lib": "rm -rf dist/lib && bun build ./src/index.ts --target=node --format=esm --outfile=dist/lib/index.js && dts-bundle-generator --silent --no-check --project tsconfig.lib.json -o dist/lib/index.d.ts src/index.ts"
  },
  "devDependencies": {
    "@toon-format/toon": "2.3.1",
    "@types/bun": "1.4.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "axi-sdk-js": "0.1.13",
    "chrono-node": "^2.9.0",
    "dts-bundle-generator": "9.5.1",
    "filtrex": "^3.1.0",
    "smol-toml": "1.9.1",
    "typescript": "^5.7.0"
  }
}
