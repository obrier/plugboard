{
  "name": "plugboard",
  "version": "0.1.0",
  "description": "claude.ai connector tools as shell commands, at zero model tokens",
  "type": "module",
  "private": true,
  "license": "MIT",
  "bin": {
    "plugboard": "./dist/plugboard"
  },
  "scripts": {
    "build": "bun build --compile --minify --outfile=dist/plugboard ./src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "link": "bun run build && bun link"
  },
  "dependencies": {
    "@toon-format/toon": "2.3.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "axi-sdk-js": "0.1.13",
    "chrono-node": "^2.9.0",
    "filtrex": "^3.1.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.1",
    "typescript": "^5.7.0"
  }
}
